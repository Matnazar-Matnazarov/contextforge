# Copy to .env and replace every CHANGE_ME. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=CHANGE_ME_long_random_string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_SECURE_COOKIES=0
APP_PORT=8080

# --- PostgreSQL ---
POSTGRES_USER=contextforge
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=contextforge

# --- RabbitMQ (Celery broker) ---
RABBITMQ_USER=contextforge
RABBITMQ_PASSWORD=CHANGE_ME

# --- SeaweedFS S3 (local dev credentials; the bucket is created by `init_services`) ---
S3_ACCESS_KEY=CHANGE_ME_access
S3_SECRET_KEY=CHANGE_ME_secret
S3_BUCKET=contextforge-documents
S3_REGION=us-east-1

# --- Qdrant ---
QDRANT_COLLECTION=knowledge_chunks

# --- Embeddings (local, no API) ---
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- Ingestion ---
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- RAG / Gemini (document excerpts + questions are sent to Google's API) ---
GEMINI_API_KEY=CHANGE_ME_from_https://aistudio.google.com/apikey
# Pick a currently supported model from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
RAG_TOP_K=6
RAG_SCORE_THRESHOLD=0.30
